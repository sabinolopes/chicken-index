# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API Keys). Na Vercel, cadastre as mesmas variáveis.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (service_role / sb_secret_...). SÓ no servidor: nunca use o prefixo
# NEXT_PUBLIC_ nem a envie para o GitHub. Usada para convidar e remover admins.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2: fotos das etiquetas (R2 → Manage API tokens, permissão
# "Object Read & Write" só neste bucket). As 3 chaves são SÓ do servidor.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=chicken-index-photos
# URL pública do bucket, sem barra no fim: https://pub-xxxx.r2.dev ou um domínio próprio
R2_PUBLIC_URL=
